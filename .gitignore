# Environment
.env
.env.local
# Local .env backups (carry secrets — DB creds, SMTP, Stripe keys). Never commit.
.env.bak
.env.bak.*
*.env.bak

# Local DB dumps / data exports — large + contain prod data/PII. Never commit.
backups/

# Docker Compose local override (auto-loaded; here it just maps postgres->5433).
# Machine-specific, not shared.
docker-compose.override.yml

# Go
backend/koshereats-api
backend/vendor/
# Node
web/node_modules/
web/.next/
web/out/
# iOS
# NOTE: don't add `ios/**/*.xcworkspace` — that matches `project.xcworkspace/`
# inside xcodeproj bundles too, which hides the SPM Package.resolved that
# Xcode Cloud needs (automatic SPM resolution is off by default there).
ios/**/xcuserdata/
ios/**/DerivedData/
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings
ios/**/*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/**/Pods/
ios/**/.build/
ios/**/build/
# Android
android/**/build/
android/**/.gradle/
android/**/local.properties
android/**/google-services*.json
google-services*.json
android/**/*.iml
android/**/*.jks
android/**/*.keystore
# Exception: the shared debug keystore is intentionally committed so every
# machine produces the same SHA-1 → Firebase / Google Sign-In stays working.
!android/debug.keystore
firebase-adminsdk*.json
*.p8
ios/**/firebase*.json
# IDE
.idea/
.vscode/
*.swp
*.swo
*~
# OS
.DS_Store
Thumbs.db
ios/koshereats-c463e-firebase-adminsdk-fbsvc-c484c84a3c.json
# Go build cache — do not commit. Added 2026-04-16 after bug-hunt ISS-004 escalated
# due to 265MB of backend/.gocache/ being scooped by `git add -A`.
backend/.gocache/

# Compiled Go binary — local build output, ~22MB Mach-O. Was tracked by
# accident (an initial commit). Now ignored; stop tracking via
# `git rm --cached backend/api`.
backend/api

# Built AAB artifacts dropped into app/release/ by 'Build > Build Bundle' from Android Studio
android/**/release/*.aab

# Gradle flavor-task output dirs (app/<flavor>/release/) — never source
android/**/app/*/release/

# local stub-mode API binary (dev testing of dispatch happy-path)
backend/ke-api-stub
build/
