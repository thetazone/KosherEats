# Backend
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/koshereats?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-in-production
WEB_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Apple
APPLE_CLIENT_ID=com.koshereats.consumer
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# APNs (push notifications)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_KEY=
APNS_BUNDLE_PREFIX=com.koshereats
APNS_PRODUCTION=false

# S3 (uploads)
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Checkr (courier background checks)
CHECKR_API_KEY=
CHECKR_PACKAGE=driver_pro
CHECKR_WEBHOOK_SECRET=

# FCM (Android push)
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Twilio Verify (phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Uber Direct (fallback courier dispatch — get creds at direct.uber.com)
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_WEBHOOK_SECRET=

# DoorDash Drive (second fallback courier — get creds at developer.doordash.com)
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_KEY=
DOORDASH_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
