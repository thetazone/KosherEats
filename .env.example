# === App Config ===
PORT=8080
APP_ENV=development
WEB_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# BASE_URL=https://api.koshereats.com
# TAX_RATE_PERCENT=8.875

# === Database ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/koshereats?sslmode=disable

# === Redis ===
REDIS_URL=redis://localhost:6379

# === JWT ===
# REQUIRED in production. Tokens are unsigned if left empty.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# === Google / Social Auth ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret

# === Apple Auth ===
APPLE_CLIENT_ID=com.koshereats.consumer
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# === APNs (iOS push notifications) ===
# Key ID and Team ID from Apple Developer portal.
# P8 key is the full contents of the .p8 file downloaded from Apple.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_KEY=
APNS_BUNDLE_PREFIX=com.koshereats
APNS_PRODUCTION=false

# === S3 (document + menu image uploads) ===
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# === Checkr (courier background checks) ===
# Empty -> dev stub mode (auto-approves couriers after 2s)
CHECKR_API_KEY=
CHECKR_PACKAGE=driver_pro
CHECKR_WEBHOOK_SECRET=

# === Firebase / FCM (Android push notifications) ===
# Service account JSON as a single string (full file contents).
# Empty -> dev stub mode (pushes logged, not sent).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# === Twilio Verify (phone-number OTP login) ===
# Empty -> dev stub mode (accepts a fixed code)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# === Uber Direct (fallback courier dispatch) ===
# Get credentials at direct.uber.com. Empty -> stub mode.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_WEBHOOK_SECRET=

# === DoorDash Drive (second fallback courier) ===
# Get credentials at developer.doordash.com. Empty -> stub mode.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_KEY=
DOORDASH_WEBHOOK_SECRET=

# === Reviewer Backdoor ===
# Gates the App Store reviewer endpoint. Empty -> endpoint disabled.
REVIEWER_SECRET=

# === Web (Next.js frontend) ===
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
